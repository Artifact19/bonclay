# BonClay Frontend Environment Configuration
# Copy this file to frontend/.env.local for local overrides.

# Backend API base URL accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public Repository switch (1 = show GitHub repository links in footer/nav, 0 = private mode)
NEXT_PUBLIC_REPO_PUBLIC=1

# Supabase Auth & Storage (OPTIONAL: leave blank for local-first storage in backend/data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
