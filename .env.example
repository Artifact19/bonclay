# ==============================================================================
# BonClay Environment Configuration
# Copy this file to .env for docker compose, or to frontend/.env.local for Next.js.
# ==============================================================================

# ---- 1. Frontend & Public URLs ----
# Backend API URL seen by the browser (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public GitHub repository link switch (1 = show GitHub links, 0 = private)
NEXT_PUBLIC_REPO_PUBLIC=1

# Optional public base URL for webhook callbacks and web calls (e.g. https://your-domain.com)
PUBLIC_BASE_URL=

# ---- 2. AI Models & Cloud Inference ----
# Groq API Key: fast cloud inference for LLaMA/Qwen LLMs and Whisper ASR
GROQ_API_KEY=
# Secondary Groq keys for automatic rate-limit failover (optional)
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Primary chat model (default: qwen/qwen3.8-27b)
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Hugging Face token for gated model downloads (e.g., Indic-Speak, DhVaani)
HF_TOKEN=

# Speech recognition fallback model when GROQ_API_KEY is not set (tiny, base, small, medium)
WHISPER_MODEL=small

# ---- 3. Voice Engines & Hardware Tuning ----
# Indic voice cloning preference: auto (DhVaani -> Chatterbox), dhvaani, or chatterbox
INDIC_CLONE_ENGINE=auto

# GPU memory budget for model manager in GB (use 3 or 4 for laptop GPUs like RTX 3050 Ti/4050)
MAX_GPU_MEMORY_GB=12

# PyTorch allocator tuning (recommended for CUDA: expandable_segments:True)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Memory guard to prevent OS swap during heavy model loads (on / off)
MEMORY_GUARD=on

# ---- 4. Database & Cloud Storage (Supabase - Optional) ----
# Leave empty to run in local-first mode (all voices and data stored locally in backend/data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- 5. Telephony & Tunneling (Optional) ----
# Tunnel kind for inbound phone calls / webhooks: auto, ngrok, cloudflared, or off
BONCLAY_TUNNEL=auto

# Local port forwarded for phone webhooks (default: 8010)
PHONE_PUBLIC_PORT=8010

# ---- 6. Docker Compose Services ----
POSTGRES_USER=bonclay
POSTGRES_PASSWORD=bonclay_dev
POSTGRES_DB=bonclay
BACKEND_BASE_IMAGE=python:3.11-slim
BACKEND_GPU_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
