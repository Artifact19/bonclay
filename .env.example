# BonClay environment. Copy to .env (docker compose) and/or frontend/.env.local
# (the backend loads ../frontend/.env.local at startup; real env vars win).

# ---- Shared (frontend + backend) ----
# string, URL. REQUIRED. Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# string. REQUIRED (frontend). Supabase anon/public key (browser-safe).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# string, URL. OPTIONAL (default http://localhost:8000). Backend base URL seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Backend ----
# string. REQUIRED (backend). Supabase service-role key. SECRET, server only.
SUPABASE_SERVICE_ROLE_KEY=
# string. REQUIRED for authenticated routes (JWT verification). Default "". SECRET.
SUPABASE_JWT_SECRET=
# string. OPTIONAL. Groq API key; enables LLM agents, evaluation, transcript features.
GROQ_API_KEY=
# string. OPTIONAL. HuggingFace token for gated model downloads.
HF_TOKEN=
# string. OPTIONAL. PyTorch allocator tuning, e.g. expandable_segments:True
PYTORCH_CUDA_ALLOC_CONF=

# ---- docker-compose ----
# string. OPTIONAL. Credentials for the bundled postgres service.
POSTGRES_USER=bonclay
POSTGRES_PASSWORD=bonclay_dev
POSTGRES_DB=bonclay
# string. OPTIONAL. Backend base images for the CPU / GPU services.
BACKEND_BASE_IMAGE=python:3.11-slim
BACKEND_GPU_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

# NODE_ENV (development|production) is set by Next.js itself; do not set manually.
