# Backend env vars (also loaded from ../frontend/.env.local if present).
# Supabase is OPTIONAL. Leave these empty to run in local mode (everything is stored in backend/data).
# Fill all three for hosted mode with sign-in (see backend/supabase/README.md).
# string, URL. e.g. https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# string. SECRET.
SUPABASE_SERVICE_ROLE_KEY=
# string. SECRET. Needed to verify sign-in tokens in hosted mode.
SUPABASE_JWT_SECRET=
# string. OPTIONAL. Enables Groq LLM features.
GROQ_API_KEY=
# string. OPTIONAL. SECRET. More Groq accounts, one key each: GROQ_API_KEY_2 to GROQ_API_KEY_9 (gaps are fine, empty is
# ignored). Groq's limits are per account and per model, so when account 1 hits a per-minute or per-day limit the same
# request goes out on account 2's key (and so on) before it falls back to a weaker model. Covers chat and speech
# recognition. A key that is refused (401/403) is skipped for an hour. Keys are shown as "1".."9", never as values.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# Groq chat model (Llama 3.3 70B was retired). Set GROQ_MODEL too to change the document Q&A model.
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# integer. OPTIONAL. Seconds a signed audio link from Supabase storage stays valid (hosted mode). Default 3600.
# SIGNED_URL_EXPIRES_S=3600
# string. OPTIONAL. HuggingFace token for gated models. scripts/setup_indic_speak.sh uses it to download Indic-Speak.
HF_TOKEN=
# string. OPTIONAL. e.g. expandable_segments:True
PYTORCH_CUDA_ALLOC_CONF=

# Local speech recognition when GROQ_API_KEY is not set (tiny, base, small, medium). small keeps Hindi in Devanagari.
WHISPER_MODEL=small

# Knowledge search (all OPTIONAL). Embedding model: BAAI/bge-m3 (1024-d, MIT, ~2.2 GB, best for Hindi/English/Hinglish) by default;
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384-d, ~0.5 GB) is the light option. Changing it re-embeds local
# knowledge automatically on the next search. Hosted mode needs backend/supabase/migrations/011_embeddings_1024.sql for 1024-d.
# EMBEDDING_MODEL=BAAI/bge-m3
# cpu (default), mps or cuda
# EMBEDDING_DEVICE=cpu
# Embedding precision: auto (default: fp16 on Apple Silicon or a GPU, fp32 on other CPUs, which mostly lack fast fp16), fp16 or fp32.
# fp16 keeps a 1.1 GB converted copy in backend/data/models, uses about 1 GB less resident memory and answers a question
# about twice as fast; documents being ingested still run in fp32 (fp16 is slower than fp32 on a CPU for long text).
# EMBEDDING_DTYPE=auto
# BM25 keyword search fused with the embedding search (default on).
# HYBRID_SEARCH=on
# Cross-encoder reranker (Alibaba-NLP/gte-multilingual-reranker-base): auto (default, see "Retrieval accuracy" at the end),
# on (every search, top 20) or off.
# RERANKER=auto

# GPU memory budget for the model manager in GB (default 12). Use 3 on a 4 GB laptop GPU such as an RTX 3050 Ti.
MAX_GPU_MEMORY_GB=12

# Memory guard: before a voice engine starts, check free RAM; if short, unload idle engines (least recently used, never one
# in the middle of a request), and if still short refuse with an INSUFFICIENT_MEMORY error instead of letting the Mac swap.
# Decisions are logged on the "bonclay.memory" logger. MEMORY_GUARD=off disables it (default on).
# MEMORY_GUARD=on
# integer, MB. Kept free on top of the engine's own need, for the OS and the app. Default 1500.
# MEMORY_GUARD_RESERVE_MB=1500
# integer, MB. Estimated memory per engine, measured on a 16 GB M4 plus 10 % (backend/bench/model_memory.py, docs/RESULTS.md):
# INDIC_SPEAK 8400, CHATTERBOX_ML 4500, INDIC_F5 3000 (not measured), DHVAANI 1000, QWEN3_0_6B 2600, KOKORO 1000,
# BACKGROUND_LLM 5000. 0 skips the check for that engine.
# MEMORY_NEED_INDIC_SPEAK_MB=8400
# integer, MB. Engines estimated at this much or more are "heavy": on macOS, while the system reports critical memory pressure,
# a heavy engine is refused unless an idle one was unloaded for it. At "warn" pressure the reserve is multiplied by 1.5. Default 1500.
# MEMORY_GUARD_HEAVY_MB=1500
# minutes. An engine unused this long is unloaded (default 5; 0 = at once). ENGINE_IDLE_UNLOAD_MIN_<ENGINE> sets one engine,
# for example ENGINE_IDLE_UNLOAD_MIN_INDIC_SPEAK=15. Pinned engines (a live call) and busy ones are never unloaded.
# ENGINE_IDLE_UNLOAD_MIN=5
# auto (default) | on | off. Keep Kokoro (the live-call voice) loaded when idle while the phone channel is set up (auto =
# the EXOTEL_* credentials are present), so the first call after a quiet hour is not cold. off: it unloads when idle like the rest.
# KEEP_LIVE_ENGINES_WARM=auto
# seconds. Stop the local speech-recognition worker after this long unused (it starts again on first use). Default 600 when a
# Groq key recognises the live speech (the worker is only the offline fallback), 0 (never) otherwise.
# MLX_ASR_IDLE_UNLOAD_S=600
# auto (default) | on | off. Whether a warm-up (./bonclay warm, startup) loads the local Whisper. auto: not when a Groq key is
# set (it loads on first use if Groq fails); on: always; off: never.
# WARM_LOCAL_ASR=auto
# auto (default) | on | off. The same for the local language model server (about 2.2 GB): auto starts it in a warm-up only when no
# hosted model (Groq, OpenAI-compatible) is configured; with one it starts on first use if the hosted model fails.
# WARM_LOCAL_LLM=auto
# auto (default) | both. Which Whisper sizes the local worker keeps: auto loads only what MLX_ASR_STRATEGY uses (large-v3-turbo
# for the default "single"); both restores the small + large pair (about 0.5 GB more).
# MLX_ASR_RESIDENT=auto

# Voice cloning on Apple Silicon (MLX, GPU). Optional; the defaults work after scripts/setup_mlx.sh.
# Python of the MLX virtualenv. Default: backend/.venv-mlx/bin/python.
# MLX_PYTHON=/path/to/backend/.venv-mlx/bin/python
# Qwen3-TTS model the MLX worker loads. Default: mlx-community/Qwen3-TTS-12Hz-0.6B-Base-8bit (about 2 GB: the same
# speaker similarity as bf16 in a trial, about 1.1 s faster per sentence). The bf16 original is
# mlx-community/Qwen3-TTS-12Hz-0.6B-Base-bf16 (about 2.3 GB, slower).
# MLX_CLONE_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-Base-8bit
# Cloned-voice generation in the MLX worker (the API's own sampling settings are not forwarded to it).
# MLX_CLONE_STREAM=on|off: on (default) decodes in streaming chunks and joins them, still one WAV: about 1 s faster per
# sentence and less than half the GPU memory; off restores the single decode.
# MLX_CLONE_STREAM=on
# MLX_CLONE_STREAM_INTERVAL=0.32   # seconds of audio per streamed chunk
# MLX_CLONE_TEMPERATURE=0.5        # sampling temperature; mlx-audio's own default is 0.9 (livelier, less like the speaker)
# These defaults were measured on synthetic Kokoro reference voices (docs/DEMO_CHECKLIST.md); confirm on a real voice.
# Set to torch to skip MLX and use PyTorch (CPU or CUDA) for voice cloning.
# CLONE_BACKEND=torch
# Kokoro (the live preset voice): auto = MLX on Apple Silicon when the MLX environment exists, PyTorch elsewhere;
# mlx = the same, named explicitly; torch = PyTorch only. A failing MLX worker always falls back to PyTorch.
# KOKORO_ENGINE=auto
# MLX_KOKORO_MODEL=mlx-community/Kokoro-82M-bf16

# Indian-language speech (Indic-Speak, preset voices). Optional; the defaults work after scripts/setup_indic_speak.sh.
# Python of the Indic-Speak virtualenv. Default: backend/.venv-indic/bin/python.
# INDIC_SPEAK_PYTHON=/path/to/backend/.venv-indic/bin/python
# Hugging Face model the worker loads. Default: bodhan-ai/indic-speak.
# INDIC_SPEAK_MODEL=bodhan-ai/indic-speak
# Longest text (characters) spoken per request; about 12 characters make a second of speech. Default 600.
# INDIC_SPEAK_MAX_CHARS=600
# Seconds to wait for one generation before giving up. Default 600.
# INDIC_SPEAK_TIMEOUT=600
# Set to off to turn Indic-Speak off; Hindi and Marathi speech then uses Kokoro's Hindi voice.
# INDIC_SPEAK=off

# Voice cloning in Indian languages (DhVaani-0.5 from ARTPARK-IISc; Hindi can also use Chatterbox). Optional: run
# ./bonclay setup --dhvaani once (needs HF_TOKEN above, with access to the gated model granted by ARTPARK-IISc).
# Which engine clones a consented voice speaking an Indian language: auto (default) = DhVaani when it is set up, and for
# Hindi Chatterbox otherwise; dhvaani = DhVaani only (an error when it is missing); chatterbox = Chatterbox for Hindi
# (the other Indian languages still use DhVaani: Chatterbox cannot clone them).
# INDIC_CLONE_ENGINE=auto
# Set to off to turn DhVaani off (Hindi then falls back to Chatterbox when it is set up; other languages to preset voices).
# DHVAANI=off
# Python of the DhVaani virtualenv. Default: backend/.venv-dhvaani/bin/python.
# DHVAANI_PYTHON=/path/to/backend/.venv-dhvaani/bin/python
# Sampling steps: 8 (default: about twice as fast as 16 with the same read-back accuracy) or 16 (the older default).
# Read-back accuracy does not show every audible difference; if a cloned voice sounds rougher than before, try 16.
# DHVAANI_STEPS=8
# Longest text (characters) cloned per request; DhVaani speaks about 12 characters a second. Default 1000.
# DHVAANI_MAX_CHARS=1000
# The worker is not started when less than this much memory (MB) is available. Default 1500; 0 turns the check off.
# DHVAANI_MIN_FREE_MB=1500
# Seconds to wait for one generation before giving up. Default 900.
# DHVAANI_TIMEOUT=900
# Set to off to turn Chatterbox (Hindi cloning, the DhVaani fallback) off.
# CHATTERBOX=off

# --- Voice consent, retention and AI labels (compliance pack; not legal advice) ---
# Days a cloned voice is kept, counted from the day it was cloned. Default 365.
# VOICE_RETENTION_DAYS=365
# on (default since 22 Oct 2026): voices past their retention date are deleted at startup and by
# POST /api/voices/retention/enforce, as the consent record promises. off: they are only listed (GET /api/voices/retention).
# VOICE_RETENTION_ENFORCE=on
# Commercial mode: offer only engines cleared for paid use. Hides and refuses DhVaani (CC-BY-NC-4.0), Indic-Speak (hosting
# needs Bodhan AI's approval) and IndicF5; Indian-language speech uses Kokoro, Hindi cloning Chatterbox (MIT). Every receipt
# names its engine's licence (engine_licence). See backend/services/licences.py. Not legal advice.
# BONCLAY_COMMERCIAL=0
# Named in the consent purpose ("... for use in BonClay by <name>") and shown as the contact in the notice.
# BONCLAY_OPERATOR_NAME=
# BONCLAY_PRIVACY_CONTACT=
# on: put a short spoken "AI generated voice" (Kokoro, English) before Studio downloads. Default off.
# AUDIBLE_AI_LABEL=off

# Offline language model (used when no cloud key works). Default: mlx-community/Llama-3.2-3B-Instruct-4bit (~2.3 GB).
# mlx-community/gemma-4-e4b-it-4bit is much better at Hindi/Marathi/Tamil and grounded answers (84% vs 49% judged in
# backend/bench/llm_compare.py) but needs ~2.5 GB more memory and is weak at offline tool calls; thinking is turned
# off automatically (MLX_LM_THINKING=on keeps it). Check the Gemma licence before commercial use.
# LOCAL_LLM_MODEL=mlx-community/gemma-4-e4b-it-4bit

# Local fallback for BACKGROUND language-model jobs (the question index and the key-fact sheet; services/background_llm.py).
# They use Groq first. When Groq answers 429, has used its daily quota, fails, or no key is set, a small model on this Mac
# does the work instead, so they no longer depend on the free Groq quota. Live replies are NOT affected: they keep
# LOCAL_LLM_MODEL and the provider chain above. The model runs only when the app is idle (no conversation turn for
# BACKGROUND_LLM_IDLE_S seconds, no phone call live) and about 5 GB of memory is free; otherwise the job waits and asks
# again. It is a separate process: stopped after BACKGROUND_LLM_UNLOAD_S idle seconds, when a conversation starts, and at the
# end of a job. Needs the model downloaded once (about 5.2 GB, Gemma licence; see docs/TRIAL_REPORT.md):
#   backend/.venv/bin/python -c "from huggingface_hub import snapshot_download; snapshot_download('mlx-community/gemma-4-e4b-it-4bit')"
# BACKGROUND_LLM_FALLBACK=local   # local (default) | off: hosted only, as before
# BACKGROUND_LOCAL_MODEL=mlx-community/gemma-4-e4b-it-4bit
# BACKGROUND_LLM_IDLE_S=60        # quiet time (no conversation turn) before the model may start
# BACKGROUND_LLM_UNLOAD_S=300     # idle seconds after which the model is unloaded
# BACKGROUND_LLM_WAIT_S=1800      # longest a job waits for idle + memory (then it fails and is retried later)
# BACKGROUND_LLM_POLL_S=15        # seconds between two checks while waiting
# BACKGROUND_LLM_BATCH=2          # passages per request to the local model (a small model slips on long lists)
# BACKGROUND_LLM_FORCE=on         # use the local model first, never the hosted one (what rechunk_knowledge.py --local does)
# MEMORY_NEED_BACKGROUND_LLM_MB=5000   # memory the model is assumed to need (measured 4.6 GB, +10 %); reserve is added (MEMORY_GUARD_RESERVE_MB)

# Phone calls over Exotel (docs: https://developer.exotel.com/docs/agentstream/getting-started)
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_ACCOUNT_SID=
# EXOTEL_CALLER_ID=            # your ExoPhone (virtual number), e.g. 08047491899
# EXOTEL_SUBDOMAIN=api.in.exotel.com
# Several Exotel accounts (trial accounts run out of credit): the lines above are account 1. Accounts 2 to 9 use the same
# names ending _2 ... _9 (a gap is fine). An account counts only when key, token, SID and caller id are all set.
# Calls go out through account 1; when it is out of credit or its credentials stop working, the next account is used.
# EXOTEL_API_KEY_2=
# EXOTEL_API_TOKEN_2=
# EXOTEL_ACCOUNT_SID_2=
# EXOTEL_CALLER_ID_2=          # the ExoPhone of account 2
# EXOTEL_SUBDOMAIN_2=api.in.exotel.com
# EXOTEL_ROTATION=failover     # failover (default): first usable account in order | round_robin: spread calls in turn
# EXOTEL_EXHAUSTED_RESET_HOURS=24   # an account that ran out of credit is tried again after this long
# Other phone providers (docs/PHONE_AND_MEETINGS.md, "Phone providers"). PHONE_PROVIDERS lists the ones to use, in order of
# preference; calls fail over to the next provider and account when one refuses the account (credit, credentials, KYC, number).
# PHONE_PROVIDERS=exotel        # e.g. twilio,exotel | exotel,twilio,plivo,vobiz,telnyx
# PHONE_ROUTES=+919876543210:exotel#2,+919812345678:twilio   # a number goes to this provider (and account #n) first
# Twilio (unverified: written from the docs). Accounts 2 to 9 end _2 ... _9. TWILIO_ROTATION / TWILIO_EXHAUSTED_RESET_HOURS as Exotel's.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_CALLER_ID=             # a Twilio number or verified caller id, e.g. +15005550006
# Plivo (unverified). PLIVO_ROTATION / PLIVO_EXHAUSTED_RESET_HOURS.
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_CALLER_ID=
# Vobiz (partly documented, unverified): Plivo-style API with its own base URL and X-Auth-ID / X-Auth-Token headers.
# VOBIZ_AUTH_ID=
# VOBIZ_AUTH_TOKEN=
# VOBIZ_CALLER_ID=
# VOBIZ_BASE_URL=https://api.vobiz.ai/api/v1
# Telnyx (unverified): Call Control; the connection is the Voice API application (connection_id).
# TELNYX_API_KEY=
# TELNYX_CONNECTION_ID=
# TELNYX_CALLER_ID=
# PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app   # set by ./bonclay start from the tunnel; by hand: ngrok http 8010
# The call stream and the status callback (the two routes Exotel calls) are also served alone on this phone-only port,
# in the same process; the tunnel points at it, never at the main API (backend/phone_public.py). 0 turns it off.
# PHONE_PUBLIC_PORT=8010
# BONCLAY_TUNNEL=auto           # auto (ngrok if installed, else cloudflared) | ngrok | cloudflared | off
# ./bonclay reads BONCLAY_TUNNEL, PHONE_PUBLIC_PORT and BONCLAY_KEEP_AWAKE from the shell first, else from this file.
# Your own tunnel (for example a named Cloudflare tunnel): BONCLAY_TUNNEL=off and PUBLIC_BASE_URL=https://phone.example.in
# here; it must point only at the phone-only port above (PHONE_PUBLIC_PORT, default 8010), never at 8000.
# Local mode trusts a request as the local user only from this computer (localhost, no proxy headers). To use the API
# from another device on your network, set a token here and send it as "Authorization: Bearer <token>".
# BONCLAY_LOCAL_TOKEN=
# PHONE_ALLOWED_NUMBERS=+919876543210                  # optional: only these can be called
# PHONE_EARLY_SILENCE_MS=250    # silence after which a reply starts speculatively (its audio waits for PHONE_END_SILENCE_MS)
# PHONE_SPECULATIVE=on          # on: the whole reply runs during the pause | asr: only speech recognition | off: no head start
# Memory and turn-taking on calls (docs/PHONE_AND_MEETINGS.md, "Memory and turn-taking on calls"):
# PHONE_CARRY_UNANSWERED=on     # the words of a reply cancelled before it was stored go with the caller's next utterance
# PHONE_ADAPTIVE_END=on         # wait longer after the agent asked for details (the three waits below)
# PHONE_DETAIL_END_SILENCE_MS=1100    # after it asked for one name, number, date, time, e-mail or address
# PHONE_DETAILS_END_SILENCE_MS=1500   # after it asked for several details at once ("the patient details")
# PHONE_INCOMPLETE_EXTRA_MS=1200      # one extra wait when the answer ends in "and"/"aur"/a comma, or holds 1-9 digits of a number asked for (0: off)
# CALLER_MEMORY=on              # a per-conversation form of what the caller said (name, phone, date, time, ...), shown to the model every turn
# CALLER_MEMORY_LLM=on          # also read it with one small Groq model call per turn, in the background (needs GROQ_API_KEY; never offline)
# CALLER_MEMORY_MODEL=openai/gpt-oss-20b   # a Groq model your account serves; it has its own quota, apart from the reply model
# BONCLAY_CALLER_DETAILS_FILE=  # cloud storage mode only: where the form is kept (default backend/data/caller_details.json, mode 0600)
# ASR_FORMAT_EXAMPLE=on         # after the agent asks for a name, number, date or time, the Whisper prompt ends with an example of its format
# PHONE_PREWARM=on              # off: no background greeting renders and warm-ups (a call still renders its own greeting)
# PHONE_MAX_CALLS=2             # live calls at once; a further call is refused (close 4429) so the Exotel flow falls back to a person
# In-call deadlines: the longest a phone turn waits for the model's next bytes before the provider chain moves on (the filler,
# PHONE_FILLER_AFTER_MS, covers the first half-second), and how long it may queue behind another local-model request.
# PHONE_LLM_STALL_S=4           # with a cloud key
# PHONE_LOCAL_LLM_TIMEOUT_S=20  # without one (the local model may be loading)
# PHONE_LOCAL_QUEUE_S=5         # instead of LOCAL_LLM_QUEUE_S (90) on a phone turn
# Heartbeat: POST a small JSON ping here every BONCLAY_HEARTBEAT_S seconds (a healthchecks.io / Uptime Kuma "ping" URL), so the
# checker alerts you within two minutes when the laptop sleeps, loses Wi-Fi or the backend stops. GET /api/health shows the
# last ping and any gap the loop noticed. Unset: nothing is sent; offline mode refuses it.
# BONCLAY_HEARTBEAT_URL=
# BONCLAY_HEARTBEAT_S=60
# ./bonclay start keeps the Mac awake while the API runs (caffeinate -is). off: leave power management alone.
# BONCLAY_KEEP_AWAKE=on
# Committing tools (book_appointment, request_meeting) first answer NOT DONE with the resolved day, date and time for the agent
# to read back ("Shall I book it?") and run on the next call once the caller said yes. off: one-step writes, as before 22 Oct 2026.
# TOOLS_READBACK=on
# PHONE_PREWARM_MAX=8           # how many phone agents get their greeting rendered (or checked) at startup
# PHONE_PREWARM_DELAY_S=5       # how long after startup that render starts, so it does not slow the startup down
# PHONE_WARM_TTL_S=60           # a warm-up of the same agent within this many seconds is skipped
# PHONE_GREETING_DIR=           # where rendered greetings are cached (default backend/data/phone_greetings, git-ignored)

# Meeting requests with the HOD (agent template "HOD Office Assistant", Approvals page) and Google Calendar.
# Without these the meeting tool uses its own list (backend/data/mcp/meetings.json). To connect a calendar: create a Google Cloud
# service account, enable the Calendar API, share the calendar with the service account's e-mail ("Make changes to events"),
# and save its JSON key as backend/data/google_calendar.json (git-ignored).
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT_FILE=backend/data/google_calendar.json
# BONCLAY_TIMEZONE=Asia/Kolkata

# Reply latency (a live spoken turn)
# TURN_FIRST_CLAUSE=on          # on (default): the first piece of a reply goes to the voice at its first comma, semicolon,
#                               # colon or dash once 4 words are in, else at a conjunction or the 8th word, instead of at the
#                               # end of the sentence. off: the older rule (a cut only after 8 words, at a comma/conjunction).
# FILLER_AUDIO=on               # the short "One moment." clip played when the answer is slow; off turns it off
# FILLER_AFTER_MS=900           # how long a typed/web turn may be silent before the filler plays
# PHONE_FILLER_AFTER_MS=500     # the same for phone calls (silence on a phone sounds like a dropped call). The filler is
#                               # never played once the model has started answering, nor while the AI disclosure plays.
# WARM_ON_START=auto            # auto (default) | on | off. Warms what a live reply needs in the background when the backend
#                               # starts: the language model's connection, Kokoro (English + Hindi) and the pre-rendered
#                               # disclosure/filler clips, the embedding model (one search per agent), the watermark model,
#                               # Groq speech recognition's connection. auto = on when the four EXOTEL_* credentials are set
#                               # or any agent exists. Never loads DhVaani, Indic-Speak, Chatterbox or the local language
#                               # model. The same warm-up is callable as backend.warm_for_live_turns().
# WARM_CLONE=on                 # on (default) | off. Part of the warm-up (startup and ./bonclay warm): start the Qwen3-TTS clone
#                               # worker (the MLX one on a Mac) and render one short sentence, discarded, with the newest
#                               # cloned voice, so the first clone and the first cloned sentence after a restart are not
#                               # ~7 s slower. Writes nothing (no generation, receipt or file). Skipped when the memory guard
#                               # has no room, and on a machine where cloning runs on PyTorch (use ./bonclay warm --clone).
#                               # off: the worker starts on the first clone, as before.
# INSTANT_ANSWERS=on            # off: never use the owner-approved instant answers (every turn runs search + the model)
# INSTANT_ANSWER_THRESHOLD=0.86 # BGE-M3 cosine a question needs to count as an approved one (bench/instant_answer_threshold.py)
# INSTANT_ANSWER_MIN_ASKS=2     # how often callers must have asked a question before it is suggested from real calls

# Answer audit (services/answer_audit.py): after a conversation, each reply grounded on the documents is checked against the
# passages the agent was given and the unsupported ones are listed on Results as "Possible mistakes". Never on a live turn.
# English only (Hindi and Hinglish replies are stored as "not checked"). Model: MiniCheck-RoBERTa-Large (MIT, 355M,
# ~1.4 GB download on the first check, pinned commit); comparison in docs/RESULTS.md (19 Oct 2026).
# ANSWER_AUDIT_MODEL=minicheck-roberta  # minicheck-roberta (default) | hhem (Vectara HHEM-2.1-Open, runs repository code,
#                               # threshold 0.9) | minicheck-ft5 (MiniCheck-Flan-T5-Large, 4.2 GB of memory)
# ANSWER_AUDIT=on               # off: no checking at all, "Check recent answers" is refused
# ANSWER_AUDIT_AUTO=on          # off: only the owner's "Check recent answers" button runs it
# ANSWER_AUDIT_AUTO_DOWNLOAD=off # on: the background job may download the model itself; off (default) waits for the owner's
#                               # first "Check recent answers" click (which downloads it once)
# AUDIT_THRESHOLD=0.5           # a reply whose weakest sentence scores below this (0..1) is flagged; default: the model's
#                               # calibrated value (MiniCheck 0.5, HHEM 0.9); tune it with the owner's "It was fine" / "It was wrong" marks
# ANSWER_AUDIT_IDLE_S=300       # unload the model after this many idle seconds
# ANSWER_AUDIT_DEVICE=cpu       # cpu (default) or mps (falls back to cpu)
# ANSWER_AUDIT_MODEL_REVISION=  # override the commit the model is pinned to (default: answer_audit.MODELS[...]["revision"])
# ANSWER_AUDIT_RUN_MAX=40       # replies checked per run / per sweep
# ANSWER_AUDIT_PHONE_IDLE_S=45  # a phone call counts as over this long after its last turn
# ANSWER_AUDIT_IDLE_AFTER_S=120 # any other conversation counts as over this long after its last turn
# ANSWER_AUDIT_POLL_S=60        # how often the background job looks for finished conversations
# ANSWER_AUDIT_SWEEP_DAYS=2     # how far back the background job looks
# BONCLAY_ANSWER_AUDIT_FILE=    # results file (default backend/data/answer_audit.json, git-ignored)

# Document ingestion: structure-aware passages and the question index (services/chunking.py, services/question_index.py)
# STRUCTURED_CHUNKING=on        # on (default): passages follow headings, FAQ pairs and table rows, each with a "Title > Section"
#                               # header (stored apart; header + content is what is embedded). PDFs are read in layout mode so
#                               # tables keep their columns. off: the older line-based passages without headers.
# QUESTION_INDEX=on             # on (default): after a document is stored, a background job asks the hosted model for 2-3 questions
#                               # per passage in English, Hindi (Devanagari) and Hinglish and stores them as search rows that
#                               # point back to their passage. Never blocks the upload; skipped when no hosted model is set.
# QUESTION_INDEX_BATCH=4        # passages per model call
# QUESTION_INDEX_TPM=4000       # model tokens per minute this job may use (live replies share the Groq quota)
# QUESTION_INDEX_MIN_INTERVAL_S=2   # smallest gap between two model calls
# QUESTION_INDEX_RETRIES=4      # tries per call when Groq answers 429 or fails
# QUESTION_INDEX_BACKOFF_S=15   # first wait after a 429 (doubles each try, at most 120 s); with the local fallback on, the
#                               # local model (BACKGROUND_LLM_FALLBACK, below) takes the batch instead of waiting

# Grounded answers: prompt, generation settings, number guard, confidence gate, key facts
# (services/grounding.py, services/fact_sheet.py, services/llm.py)
# GROUNDING_PROMPT=v2           # v2 (default): copy numbers/times/fees/names exactly and write them in digits in every
#                               # language, never confirm a day/time/price/person/service the caller assumes unless the
#                               # passages say it (say what they do say), no yes/no about things they never mention,
#                               # refuse and offer a call back when the passages lack the answer, answer first then at most
#                               # one detail, 3 short examples (English, a Hindi correction of a wrong day, a Hinglish
#                               # refusal). v1: the earlier prompt, for A/B comparison.
# RETRIEVAL_TOP_K=4             # passages retrieved per turn (default 4: the doc QA evaluation found every top-3 miss at
#                               # rank 4; one passage is about 170 prompt tokens). Read at start-up.
# GROUNDING_TOP_K=              # passages shown to the model with the v2 prompt (best first, question last); default: the
#                               # same as RETRIEVAL_TOP_K
# ANSWER_GUARD=on               # every number, time, fee, phone number and date in a reply must appear in the passages, the
#                               # key facts, the agent's instructions/greeting, the caller's words or a tool's result; a
#                               # sentence that names one that does not is replaced by the callback line before it is spoken
#                               # and the reply stops there (turn timings: guard="number"). Under 1 ms per sentence.
# CONFIDENCE_GATE=on            # retrieval rated its passages "none"/"low": no model call, the callback line is the reply
#                               # (timings: guard="low_confidence"). Not for small talk, tool agents, a reply to the agent's
#                               # own question, or when the rating is missing.
# FACT_SHEET=on                 # per agent, the hosted model lists the hard facts of its documents once per document set
#                               # (timings, fees, phones, addresses, doctor days; every value checked verbatim against the
#                               # text) and the ones that match a question go into the prompt as "Key facts". Built in the
#                               # background, never waited for; skipped without a hosted model.
# FACT_SHEET_DIR=               # where sheets are cached (default backend/data/fact_sheets, git-ignored)
# LLM_ANSWER_TEMPERATURE=0.2    # temperature of a spoken answer (0..1; tool calls keep their own)
# LLM_THINKING=off              # off (default): Qwen3 answers without a reasoning pass (Groq reasoning_effort "none"); tool
#                               # requests are left unchanged. on: the model's default thinking.
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b   # enterprise accounts can put llama-3.3-70b-versatile first
#                               # tried in order when GROQ_CHAT_MODEL is rate limited or down. Llama 3.3 70B first: lowest
#                               # hallucination rate on Vectara's leaderboard of the models Groq has served (4.1 % vs 14.2 %
#                               # for gpt-oss-120b); Groq has retired it for free/developer accounts, where its 404 is paid
#                               # once and the model is then skipped for GROQ_DEAD_MODEL_S. "" turns fallback off.
# When every Groq model is at its per-minute limit and Groq says "try again in 1.6s", wait up to this many seconds and ask
# once more instead of dropping to the local 3B model (which cost a web turn 10.5 s on 22 Oct 2026). 0 turns the wait off.
# GROQ_MINUTE_WAIT_S=3
# GROQ_DEAD_MODEL_S=3600        # how long a model that answered "not found / decommissioned" is skipped
#                               # A model whose 429 says its DAILY quota is used up ("tokens per day (TPD)", "requests per
#                               # day (RPD)") is skipped until the quota resets (the error's "try again in", else
#                               # retry-after / x-ratelimit-reset-requests, else the next midnight UTC; logged once; listed
#                               # under llm.groq_paused in /api/health). A per-minute 429 only moves that turn to the next model.
#                               # Groq's gpt-oss models answer the JSON tool prompt with a native tool call, which Groq
#                               # rejects (HTTP 400 tool_use_failed); the call in its failed_generation is used, else the
#                               # model is asked once more for a plain answer. No setting.

# Query understanding on a live turn (services/query_understanding.py): ASR vocabulary, entity snapping, ASR confidence
# and clarification, follow-up condensation. Each switch can be turned off on its own for an A/B.
# ASR_VOCAB_PROMPT=on           # Whisper `prompt` (Groq) / `initial_prompt` (local) built per agent from its name, greeting
#                               # and documents (doctor names, departments, places, fee words); rebuilt when documents change
# ASR_VOCAB_PROMPT_TOKENS=100   # estimated-token budget of that prompt (over-counts; 100 ~ 70 real tokens; max 200)
# ASR_LANGUAGE_HINT=on          # pass `language` to Whisper for a single-language agent only (never for en+hi / Hinglish)
# ASR_VERBOSE_JSON=on           # ask Groq for verbose_json (avg_logprob / no_speech_prob per segment) for ASR confidence
# ASR_CLARIFY=phone             # phone (default) | on | off: on low ASR confidence, ask one short question in the caller's
#                               # language ("Which doctor did you mean?") instead of answering. Never twice in a row.
# ASR_LOW_LOGPROB=-0.9          # avg_logprob below this = low confidence
# ASR_HIGH_LOGPROB=-0.4         # avg_logprob at or above this (and little no-speech) = high confidence
# QUERY_ENTITY_SNAP=on          # snap near-miss names/terms in the transcript to the agent's lexicon (search query only)
# QUERY_CONDENSE=on             # on | rules | off: rewrite short follow-ups ("aur Monday ko?") into a standalone search
#                               # query; rules first, a tiny Groq call only when rules cannot (rules = never the LLM)
# QUERY_CONDENSE_TIMEOUT_MS=400 # the condensation LLM call's limit; on timeout the raw transcript is searched

# Retrieval accuracy (services/retrieval.py, services/m3_modes.py; bench: backend/bench/retrieval_modes_bench.py)
# RETRIEVAL_FUSION=weighted     # weighted (default): convex combination of normalised scores (Bruch et al. 2023);
#                               # rrf: the previous Reciprocal Rank Fusion (k=60) of the dense and BM25 rankings
# RETRIEVAL_WEIGHTS=dense:0.4,sparse:0,colbert:0.3,bm25:0.1   # any subset; 0 switches a signal off (RESULTS.md, 19 Oct
#                               # 2026). Without the BGE-M3 heads only dense + BM25 are present (0.8 : 0.2 after renormalising)
# RETRIEVAL_NORM=tmm            # tmm (default): score / best score; minmax: (score - min) / (max - min) over the candidates
# RETRIEVAL_CANDIDATES=20       # candidates = union of the dense top-N and the BM25 top-N
# M3_MODES=on                   # BGE-M3 sparse (lexical) + multi-vector (ColBERT) scores from the same forward pass as the
#                               # dense vector. Inert until the two head files (~2 MB) are on disk:
#                               #   backend/.venv/bin/python -m services.m3_modes --download-heads
# M3_HEADS_DIR=                 # folder holding sparse_linear.pt + colbert_linear.pt (default: HF cache / the fp16 copy)
# M3_CACHE_DIR=                 # passage vectors on disk, one .npz per passage (default backend/data/m3_cache)
# M3_CACHE_MB=256               # passage vectors kept in memory (a 50-page document is about 80 MB)
# M3_DISK_MB=2048               # sidecar files kept on disk before the oldest are removed
# M3_PAUSE_MS=30                # pause between background passage batches (the first search of an agent queues them)
# M3_BULK_NEED_MB=2600          # free memory needed to compute passages with a temporary float32 copy (else fp16, slower)
# RERANK_AUTO_GAP=0.10          # RERANKER=auto reranks when the fused top1 - top2 gap is below this or confidence is medium,
# RERANK_AUTO_CANDIDATES=3      # at most this many passages, cut to RERANK_AUTO_WORDS words; only when the model is
# RERANK_AUTO_WORDS=180         # already downloaded (never fetched) and in memory (loaded in the background on first need
# MEMORY_NEED_RERANKER_MB=      # if memory_guard allows this much; default per model: gte 1700, bge 2000, Qwen3 2500)
# RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base   # Apache-2.0, runs repository code (both repos pinned);
#                               # or BAAI/bge-reranker-v2-m3, or Qwen/Qwen3-Reranker-0.6B (yes/no LLM scoring). Download once:
#                               #   hf download Alibaba-NLP/gte-multilingual-reranker-base && hf download Alibaba-NLP/new-impl
# RERANKER_DEVICE=auto          # auto: Apple's GPU (mps) on Apple Silicon, else EMBEDDING_DEVICE; or cpu | mps | cuda
# RERANKER_DTYPE=auto           # auto: fp16 on a GPU, fp32 on a CPU (fp16 is ~5x slower on a CPU); or fp16 | bf16 | fp32
# RERANKER_REVISION=            # model commit to load (default: the pinned one for remote-code models, else the cached main)
# RERANKER_INSTRUCTION=         # Qwen3-Reranker only: the <Instruct> line (default: the model card's web-search one)
# Retrieval confidence (contract 2: high / medium / low / none, stored with each turn and read by the grounding gate):
# RETRIEVAL_CONF_DENSE_HIGH=0.58  RETRIEVAL_CONF_DENSE_LOW=0.40  RETRIEVAL_CONF_DENSE_NONE=0.30  RETRIEVAL_CONF_GAP_CLEAR=0.15
# RETRIEVAL_CONF_OVERLAP_HIGH=0.5 RETRIEVAL_CONF_OVERLAP_LOW=0.15 RETRIEVAL_CONF_RERANK_HIGH=0.7 RETRIEVAL_CONF_RERANK_LOW=0
#                               # (RERANK_LOW 0 = off: bge scores answerable Hinglish questions ~0.001, see RESULTS.md)

# Offline mode: 1 refuses Groq, remote language-model servers, Supabase, webhooks, Google Sheets/Calendar, Exotel,
# WhatsApp and Hugging Face downloads, so nothing leaves this computer. Cache the models first (./bonclay warm).
# GET /api/privacy/attestation then returns a signed statement of this configuration.
# BONCLAY_OFFLINE=0
# Local model server (mlx_lm) prompt cache limits. Default 600 MB and 4 conversations; 0 removes the limit.
# MLX_PROMPT_CACHE_MB=600
# MLX_PROMPT_CACHE_SIZE=4

# Receipt signing-key rotation: `backend/scripts/rotate_receipt_key.py --yes` (API stopped) retires the current Ed25519 key into
# data/receipt_ed25519.retired and starts a new one; old receipts and withdrawal-log rows keep verifying by their key_id, and
# /.well-known/bonclay-receipt-key lists every key. When the key lives in BONCLAY_RECEIPT_SIGNING_KEY, rotate it by hand and
# list the old public keys (base64, comma-separated) here:
# BONCLAY_RECEIPT_RETIRED_KEYS=
# C2PA manifest on every generated WAV (services/c2pa_manifest.py): a signed, standard provenance record beside the watermark,
# readable by c2patool and Content Credentials, with the receipt id and key id inside. Needs `backend/.venv/bin/pip install
# c2pa-python` (Apache-2.0 OR MIT). Without a real certificate a self-signed test chain is made in data/c2pa/ (readers show it as
# an untrusted signer: integrity, not identity). The samples and the watermark are untouched; /verify shows the manifest.
# C2PA_MANIFEST=off
# C2PA_CERT_FILE=                # PEM: signing certificate then its chain
# C2PA_KEY_FILE=                 # PEM: PKCS#8 private key
# BONCLAY_PUBLIC_URL=            # if set, the manifest carries verify_url and keys_url under this address

# Voice vault: cloned voices are sealed on disk (AES-256-GCM); withdrawing consent destroys the key. See docs/VOICE_VAULT.md.
# VOICE_VAULT=on                # off: keep voice files plain
# BONCLAY_VAULT_KEY=            # base64 of 32 bytes; default: macOS Keychain, else ~/.bonclay/voice_kek. Back it up with your voices.
# VOICE_VAULT_KEYCHAIN=on       # off: skip the macOS Keychain
