.venv-chatterbox/
data/test-run-backup-*/
data/receipts.jsonl
data/receipts.json.migrated
data/logs/

# Per-agent integration secrets and delivery logs (services/integrations.py)
data/integrations/

# Secrets and keys written or expected under data/ (never commit)
data/widget_secret
data/google_calendar.json
data/*.pem
data/phone_numbers.json
data/say_it_once_rtf.json

# Rendered phone greetings (services/phone_greeting.py) and the owner's instant answers (services/instant_answers.py)
data/phone_greetings/
data/instant_answers.json

# Answer audit results (services/answer_audit.py)
data/answer_audit.json

# Per-agent fact sheets built from the documents (services/fact_sheet.py)
data/fact_sheets/

# Everything the running app writes under data/ is private (voices, call records, accounts, keys, caches): never commit it.
data/*
